#: templates/nabairqualityd/animations_help.html:5
#: templates/nabairqualityd/settings.html:6
msgid "Air quality"
msgstr "大気質"

#: templates/nabairqualityd/animations_help.html:11
#: templates/nabairqualityd/settings.html:9
msgid "The air quality visual animations"
msgstr "大気質のビジュアルアニメーション"

