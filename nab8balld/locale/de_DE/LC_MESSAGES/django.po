msgid "take a step back and see what awaits you"
msgstr "beobachte, dann wirst du sehen was auf dich zukommt"

msgid "avoid getting all happy"
msgstr "immer mit der Ruhe, es ist noch nichts entschieden"

msgid "prepare yourself for a few nasty repercussions"
msgstr "du musst einige Hürden überwinden"

msgid "not just yet wait a little"
msgstr "warte auf einen besseren Vorschlag"

msgid "yes"
msgstr "na klar"

msgid "no"
msgstr "nein so geht das nicht, du nimmst es auf die leichte Schulter"

msgid "yes or maybe no"
msgstr "ja oder besser nein"

msgid "that's for sure"
msgstr "na das steht fest"

msgid "never"
msgstr "niemals, hörst du"

