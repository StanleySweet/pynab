# TTS - transcribed from French MP3 audio
msgid "go for it"
msgstr "allez, tu devrais tenter l'aventure"

msgid "but it's so obvious"
msgstr "mais oui bien sûr"

msgid "definitely but have a little fun"
msgstr "ça va être super"

msgid "be sure not to make any waves"
msgstr "attention aux détails"

msgid "well I wouldn't bet on that"
msgstr "c'est pas sûr"

msgid "stop wasting time"
msgstr "dépêche-toi de faire"

msgid "don't be ridiculous"
msgstr "bah oui mais bon ça veut rien dire"

msgid "haste makes waste"
msgstr "je pense sans vouloir te commander que tu devrais revoir tes priorités"

msgid "think of it as a long-term investment"
msgstr "à l'avenir ça sera d'un super grand soutien"

msgid "change your approach"
msgstr "comment dire, change d'objectif"

msgid "take a step back and see what awaits you"
msgstr "après ça tu verras les choses différemment"

msgid "avoid getting all happy"
msgstr "hola ne t'emballe pas, c'est pas certain encore"

msgid "prepare yourself for a few nasty repercussions"
msgstr "il faudra que tu surmontes quelques obstacles"

msgid "not just yet wait a little"
msgstr "attends une meilleure proposition"

msgid "yes"
msgstr "ce serait merveilleux"

msgid "no"
msgstr "désolé mais on dit que c'est pas pour tout de suite"

msgid "yes or maybe no"
msgstr "alors peut-être que tu devrais chercher d'autres options"

msgid "that's for sure"
msgstr "ça c'est sûr à 100 %"

msgid "never"
msgstr "jamais tu m'entends"

msgid "indubitably"
msgstr "incontestablement"


msgid "don't get too involved"
msgstr "ne t'implique pas trop"

msgid "people will be there to help you"
msgstr "des gens t'aideront"

msgid "best thing to do is to just laugh it off"
msgstr "mieux vaut en rire, hein. Enfin je dis ça..."
