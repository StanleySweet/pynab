# TTS - transcribed from MP3 audio
msgid "go for it"
msgstr "venga, deberías lanzarte a la aventura"

msgid "but it's so obvious"
msgstr "ah bueno, claro, por supuesto que sí"

msgid "definitely but have a little fun"
msgstr "sí pero diviértete un poco"

msgid "be sure not to make any waves"
msgstr "yo diría que fueras con prudencia"

msgid "well I wouldn't bet on that"
msgstr "ah mmm no apuestes por eso eh"

msgid "stop wasting time"
msgstr "para de perder tu tiempo"

msgid "don't be ridiculous"
msgstr "no seas ridículo eh, un poco de dignidad"

msgid "haste makes waste"
msgstr "no sirve de nada querer ir demasiado deprisa"

msgid "think of it as a long-term investment"
msgstr "es una inversión a largo plazo"

msgid "change your approach"
msgstr "cambia de enfoque"

msgid "take a step back and see what awaits you"
msgstr "observa y mira lo que te depara el destino"

msgid "avoid getting all happy"
msgstr "no te embales, este tema sigue siendo un poco dudoso"

msgid "prepare yourself for a few nasty repercussions"
msgstr "tendrás que superar algunos obstáculos"

msgid "not just yet wait a little"
msgstr "espera una propuesta mejor"

msgid "yes"
msgstr "uh, sería maravilloso"

msgid "no"
msgstr "lo siento pero me dicen que no es para ahora mismo"

msgid "yes or maybe no"
msgstr "quizás deberías buscar otras opciones"

msgid "that's for sure"
msgstr "eso es seguro al 100%"

msgid "never"
msgstr "nunca, ¿me oyes?"

msgid "indubitably"
msgstr "indiscutiblemente"


msgid "don't get too involved"
msgstr "no te impliques demasiado"

msgid "people will be there to help you"
msgstr "la gente te ayudará"

msgid "best thing to do is to just laugh it off"
msgstr "mejor reírse, en fin, eso digo yo..."
